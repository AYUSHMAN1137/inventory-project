{
  "name": "deeptech-lab-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Deep-Tech Innovation Centre Lab Inventory Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report",
    "generate:contracts": "openapi-typescript packages/contracts/openapi.yaml -o packages/contracts/generated/api.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.6.1",
    "playwright": "^1.63.0",
    "supertest": "^7.3.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
