# ---------------------------------------------------------------------------
# Local development environment for the Deep-Tech Lab Inventory API.
# Copy to `.env` (or export these) before running `npm run dev:api`.
# NEVER commit a real `.env` — production secrets come from the host's
# secret store (see docs/operations.md).
# ---------------------------------------------------------------------------

# SQLite for local development. Production uses PostgreSQL via
# apps/api/prisma/schema.postgresql.prisma — see docs/operations.md.
DATABASE_URL="file:./dev.db"

PORT=4000

# Validated at boot. Must be at least 32 characters outside tests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-value-of-at-least-32-characters"

NODE_ENV="development"

# Origin the API is served from (used behind the TLS proxy in production).
APP_ORIGIN="http://localhost:4000"

# Dev-only CORS origin for the Vite dev server.
WEB_ORIGIN="http://localhost:5173"

# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Web (apps/web) — prefix is required for anything the browser may see.
# NEVER put a backend secret in a VITE_ variable: it is inlined into the
# public JS bundle.
# ---------------------------------------------------------------------------

# Set to true only on a local machine to show the seeded-account hint on the
# login screen. Keep false/absent in production.
VITE_SHOW_DEMO_HINTS=false
